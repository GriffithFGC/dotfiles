#!/usr/bin/env python3
"""Copy the 43PR palette into Spicetify's [43PR] color scheme and refresh Spotify.

theme.py renders ~/.cache/43pr/spicetify-colors.ini; this replaces the [43PR]
section of the active theme's color.ini with it and runs `spicetify refresh`,
which rewrites xpui/colors.css. The theme's theme.js notices the new colors.css
and swaps it in live, so a running Spotify recolors without a restart.
"""
import re, subprocess, sys
from pathlib import Path

HOME = Path.home()
SECTION = HOME / ".cache/43pr/spicetify-colors.ini"
COLOR_INI = HOME / ".config/spicetify/Themes/text/color.ini"


def main():
    new = SECTION.read_text().strip() + "\n"
    ini = COLOR_INI.resolve()             # color.ini is a symlink into dotfiles
    text = ini.read_text()
    # The generated block starts at its "; Generated" comment (or a bare [43PR])
    # and runs until the next section header.
    block = re.compile(r"(?ms)^(?:; Generated by 43pr[^\n]*\n(?:;[^\n]*\n)*)?\[43PR\]\n.*?(?=^\[|\Z)")
    if block.search(text):
        text = block.sub(lambda _: new + "\n", text, count=1)
    else:
        text = text.rstrip("\n") + "\n\n" + new
    tmp = ini.with_name(f".{ini.name}.43pr-tmp")
    tmp.write_text(text)
    tmp.replace(ini)
    r = subprocess.run(["spicetify", "refresh", "-n"], stdin=subprocess.DEVNULL,
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        sys.exit(f"spicetify refresh failed: {(r.stderr or r.stdout).strip()}")


if __name__ == "__main__":
    main()
