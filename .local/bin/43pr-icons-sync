#!/usr/bin/env python3
"""Draw the "Minimal 43PR" folder icons in the 43PR palette.

theme.py renders the folder colors to ~/.cache/43pr/icons-colors; this builds
~/.local/share/icons/Papirus-43pr, a theme that inherits Papirus-Dark and only
overrides the folder icons with a flat, rounded design: tab (body darkened),
body (accent) and a thin round-capped glyph (symbol color) picked from the
folder's name. Like papirus-folders, every generic name that Papirus-Dark points
at the current folder color (folder.svg -> folder-white.svg) gets an icon.
Sizes under 32px get the plain folder: glyphs don't read that small.

Running GTK apps (Thunar) cache their icons until the icon theme setting changes,
so the theme is then re-selected under its twin name Papirus-43pr-alt (a symlink
to the same directory) and back on the next run: they reload with no flash.
"""
import colorsys, configparser, math, os, re, subprocess
from pathlib import Path

HOME = Path.home()
COLORS = HOME / ".cache/43pr/icons-colors"
BASE = Path("/usr/share/icons/Papirus-Dark")
OUT = HOME / ".local/share/icons/Papirus-43pr"

FOLDER = """<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
 <path d="M14 10h12.5c2 0 3.2.8 4.4 2.3l1.6 2c.8 1 1.6 1.4 2.9 1.4H50a8 8 0 0 1 8 8v2H6v-7.7A8 8 0 0 1 14 10z" fill="{tab}"/>
 <rect x="6" y="20" width="52" height="36" rx="9" fill="{body}"/>
 <g fill="none" stroke="{symbol}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">{glyph}</g>
</svg>
"""


def star(cx=32, cy=37, r=7.5, ri=3.4):
    pts = []
    for i in range(10):
        a = math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else ri
        pts.append(f"{cx + rr * math.cos(a):.2f} {cy - rr * math.sin(a):.2f}")
    return f'<path d="M{"L".join(pts)}z"/>'


# Glyphs live in the body (x 22-42, y 29-45). First matching pattern wins.
GLYPHS = [
    (r"documents|text|notes|txt|obsidian", '<path d="M27 30h7l4 4v9a1.5 1.5 0 0 1-1.5 1.5h-9.5a1.5 1.5 0 0 1-1.5-1.5V31.5A1.5 1.5 0 0 1 27 30zM34 30v4h4"/>'),
    (r"download|torrent", '<path d="M32 29v11M27 35.5l5 5 5-5M26 45h12"/>'),
    (r"music|sound|audio", '<circle cx="27.5" cy="42" r="2.5"/><circle cx="37.5" cy="40" r="2.5"/><path d="M30 42V31.5l10-2.5V40"/>'),
    (r"picture|image|photo|camera|screenshot|wallpaper", '<rect x="24.5" y="30" width="15" height="14" rx="2.5"/><path d="M25 41l4.5-4.5 3.5 3.5 2-2 4 4"/>'),
    (r"video|movie", '<rect x="23" y="31" width="13" height="11" rx="2.5"/><path d="M36 34.5l4.5-2.5v9L36 38.5"/>'),
    (r"desktop", '<rect x="23.5" y="30" width="17" height="11" rx="2"/><path d="M29 45h6M32 41v4"/>'),
    (r"home", '<path d="M25 36.5l7-6.5 7 6.5M27.5 34.5V44h9v-9.5"/>'),
    (r"template", '<rect x="24.5" y="30" width="15" height="14" rx="2.5" stroke-dasharray="3 3"/>'),
    (r"public|share", '<circle cx="27" cy="37" r="2.2"/><circle cx="37" cy="31.5" r="2.2"/><circle cx="37" cy="42.5" r="2.2"/><path d="M29 36l6-3.4M29 38l6 3.4"/>'),
    (r"git", '<circle cx="27" cy="30.5" r="2.2"/><circle cx="27" cy="43.5" r="2.2"/><circle cx="37" cy="33" r="2.2"/><path d="M27 32.7v8.6M37 35.2c0 4-10 2.6-10 6.1"/>'),
    (r"game|steam|wine", '<rect x="22.5" y="32" width="19" height="11" rx="5.5"/><path d="M27 37.5h4M29 35.5v4M36 36.5h.01M38.5 38.5h.01"/>'),
    (r"code|develop|java|python|rust|project|src|script", '<path d="M28 32l-5 5 5 5M36 32l5 5-5 5M33.5 30.5l-3 13"/>'),
    (r"cloud|dropbox|drive|mega|onedrive|yandex", '<path d="M27 43h10.5a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 27.6 34a4.5 4.5 0 0 0-.6 9z"/>'),
    (r"network|remote|nfs|ssh|ftp|smb|web|html|wifi", '<circle cx="32" cy="37" r="7.5"/><path d="M24.5 37h15M32 29.5c-2.5 2-3.5 4.5-3.5 7.5s1 5.5 3.5 7.5c2.5-2 3.5-4.5 3.5-7.5s-1-5.5-3.5-7.5z"/>'),
    (r"favorite|bookmark|star", star()),
    (r"lock|encrypt|private|vault", '<rect x="25.5" y="35.5" width="13" height="9.5" rx="2.5"/><path d="M28 35.5V33a4 4 0 0 1 8 0v2.5"/>'),
    (r"important", '<path d="M32 30v8M32 43.5v.01"/>'),
    (r"recent|activit|history", '<circle cx="32" cy="37" r="7.5"/><path d="M32 33v4.5l3 2"/>'),
    (r"backup|sync", '<path d="M39 37a7 7 0 1 1-2-4.9M37.5 28.5v3.8h-3.8"/>'),
    (r"mail", '<rect x="23.5" y="31" width="17" height="12" rx="2.5"/><path d="M24.5 32.5l7.5 5.5 7.5-5.5"/>'),
    (r"book|library", '<path d="M24 31.5c3-1 5.5-1 8 1 2.5-2 5-2 8-1v12c-3-1-5.5-1-8 1-2.5-2-5-2-8-1zM32 32.5v12"/>'),
    (r"app|program", '<rect x="24.5" y="29.5" width="6" height="6" rx="1.5"/><rect x="33.5" y="29.5" width="6" height="6" rx="1.5"/><rect x="24.5" y="38.5" width="6" height="6" rx="1.5"/><rect x="33.5" y="38.5" width="6" height="6" rx="1.5"/>'),
]


def glyph_for(name):
    stem = re.sub(r"^(folder|user)-?", "", name[:-len(".svg")])
    for pattern, glyph in GLYPHS:
        if re.search(pattern, stem):
            return glyph
    return ""


def darker(hexcolor, f=0.88):
    r, g, b = (int(hexcolor[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    r, g, b = colorsys.hls_to_rgb(h, l * f, min(1.0, s * 1.1))
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (r, g, b))


def atomic_write(path, text):
    tmp = path.with_name(f".{path.name}.43pr-tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def main():
    conf = dict(line.split("=", 1) for line in COLORS.read_text().split() if "=" in line)
    colors = {"body": conf["body"], "tab": darker(conf["body"]), "symbol": conf["symbol"]}

    index = configparser.ConfigParser(interpolation=None)
    index.optionxform = str
    index.read(BASE / "index.theme")
    dirs = [d for d in index["Icon Theme"]["Directories"].split(",")
            if d.endswith("/places") and "symbolic" not in d]

    out = configparser.ConfigParser(interpolation=None)
    out.optionxform = str
    out["Icon Theme"] = {"Name": "Papirus-43pr", "Comment": "Papirus-Dark with Minimal 43PR folders",
                         "Inherits": "Papirus-Dark", "Directories": ",".join(dirs)}

    for d in dirs:
        out[d] = dict(index[d])
        pixels = int(index[d].get("Size", "64")) * int(index[d].get("Scale", "1"))
        src = (BASE / d).resolve()
        dst = OUT / d
        dst.mkdir(parents=True, exist_ok=True)
        folder = src / "folder.svg"
        if not folder.is_symlink():
            continue
        # current papirus-folders color, e.g. "white" from folder-white.svg
        color = os.readlink(folder)[len("folder-"):-len(".svg")]
        for entry in src.iterdir():
            if not entry.is_symlink():
                continue
            if not re.fullmatch(rf"(folder|user)-{re.escape(color)}(-.+)?\.svg", entry.resolve().name):
                continue
            glyph = glyph_for(entry.name) if pixels >= 32 else ""
            atomic_write(dst / entry.name, FOLDER.format(glyph=glyph, **colors))

    OUT.mkdir(parents=True, exist_ok=True)
    with open(OUT / ".index.theme.43pr-tmp", "w") as f:
        out.write(f, space_around_delimiters=False)
    os.replace(OUT / ".index.theme.43pr-tmp", OUT / "index.theme")
    reselect()


def reselect():
    twin = OUT.with_name(OUT.name + "-alt")
    if not twin.is_symlink():
        twin.symlink_to(OUT.name)
    key = ["org.gnome.desktop.interface", "icon-theme"]
    try:
        cur = subprocess.run(["gsettings", "get", *key], capture_output=True, text=True,
                             timeout=5).stdout.strip().strip("'")
        if cur in (OUT.name, twin.name):        # leave a theme the user picked alone
            new = twin.name if cur == OUT.name else OUT.name
            subprocess.run(["gsettings", "set", *key, new], capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


if __name__ == "__main__":
    main()
