/* Generated by 43pr theme.py from ~/.config/43pr/templates/qt5ct.qss. Do not edit.
 * Appended by qt5ct to the stylesheet of the apps that use it (KeePassXC):
 * flat, borderless widgets on kitty's background; focus shows as a lighter field. */

QFrame,
QAbstractScrollArea,
QHeaderView::section,
QTabWidget::pane,
QToolBar,
QStatusBar,
QSplitter::handle {
    border: none;
}

QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit,
QTextEdit {
    background-color: {{bg_card}};
    border: 1px solid {{bg_card}};
    border-radius: 6px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    background-color: {{bg_hover}};
    border-color: {{bg_hover}};
}

QScrollBar {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    height: 8px;
}

QScrollBar:vertical {
    width: 8px;
}

QScrollBar::handle {
    background: {{bg_hover}};
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background: {{border}};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QPushButton {
    background-color: {{bg_card}};
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: {{bg_hover}};
}

QPushButton:default,
QPushButton:checked {
    background-color: {{selection_bg}};
}

QToolTip {
    background-color: {{bg_card}};
    color: {{fg}};
    border: none;
}
