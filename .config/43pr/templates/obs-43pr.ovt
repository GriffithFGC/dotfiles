/* Generated by 43pr theme.py from ~/.config/43pr/templates/obs-43pr.ovt. Do not edit.
 * Yami recolored like kitty: terminal background everywhere, kitty's selection
 * color for selected items (readable with the normal text), the palette accent
 * on focus, links and toggles, JetBrainsMono and no borders. */

@OBSThemeMeta {
    name: '43PR';
    id: 'com.obsproject.Yami.43PR';
    extends: 'com.obsproject.Yami';
    author: '43pr';
    dark: 'true';
}

@OBSThemeVars {
    /* Yami's color ramps, rebuilt from the palette (1 = brightest) */
    --blue1: {{accent}};
    --blue2: {{accent}};
    --blue3: {{selection_bg}};
    --blue4: {{selection_bg}};
    --blue5: {{bg_card}};
    --blue6: {{bg_panel}};

    --red1: {{term1}};
    --red2: {{term1}};
    --red3: {{danger}};
    --red4: {{selection_bg}};
    --red5: {{bg_track}};
    --red6: {{bg_card}};

    --pink1: {{term13}};
    --pink2: {{term13}};
    --pink3: {{selection_bg}};
    --pink4: {{selection_bg}};
    --pink5: {{bg_track}};
    --pink6: {{bg_card}};

    --teal1: {{term6}};
    --teal2: {{term6}};
    --teal3: {{selection_bg}};
    --teal4: {{selection_bg}};
    --teal5: {{bg_track}};
    --teal6: {{bg_card}};

    --purple1: {{term5}};
    --purple2: {{term5}};
    --purple3: {{term5}};
    --purple4: {{selection_bg}};
    --purple5: {{selection_bg}};
    --purple6: {{bg_card}};

    --green1: {{term2}};
    --green2: {{term2}};
    --green3: {{selection_bg}};
    --green4: {{selection_bg}};
    --green5: {{bg_track}};
    --green6: {{bg_card}};

    --yellow1: {{term3}};
    --yellow2: {{term3}};
    --yellow3: {{term3}};
    --yellow4: {{selection_bg}};
    --yellow5: {{bg_track}};
    --yellow6: {{bg_card}};

    --grey1: {{fg_faint}};
    --grey2: {{border}};
    --grey3: {{bg_hover}};
    --grey4: {{bg_track}};
    --grey5: {{bg_card}};
    --grey6: {{bg_panel}};
    --grey7: {{bg}};
    --grey8: {{bg}};

    --white1: {{fg}};
    --white2: {{fg}};
    --white3: {{fg_dim}};
    --white4: {{fg_dim}};
    --white5: {{fg_muted}};

    --black1: {{bg}};
    --black2: {{bg_panel}};
    --black3: {{bg_track}};
    --black4: {{border}};
    --black5: {{fg_muted}};

    /* Base colors: kitty's background and text */
    --bg_window: {{bg}};
    --bg_base: {{bg}};
    --bg_preview: {{bg_panel}};

    --primary: {{selection_bg}};
    --primary_light: {{bg_hover}};
    --primary_lighter: {{accent}};
    --primary_dark: {{selection_bg}};
    --primary_darker: {{bg_card}};

    --warning: {{term3}};
    --danger: {{danger}};

    --text: {{fg}};
    --text_light: {{fg}};
    --text_muted: {{fg_muted}};
    --text_inactive: {{fg}};

    --highlight_color: {{accent}};
    --separator_hover: {{accent}};

    /* No outlines: the background shades separate things */
    --border_color: {{bg_track}};
    --input_bg: {{bg_card}};
    --input_bg_hover: {{bg_hover}};
    --input_bg_focus: {{bg_card}};
    --input_border: {{bg_card}};
    --input_border_hover: {{bg_hover}};
    --input_border_focus: {{accent}};
    --button_bg: {{bg_card}};
    --button_bg_hover: {{bg_hover}};
    --button_bg_down: {{selection_bg}};
    --button_bg_disabled: {{bg_panel}};
    --button_border: {{bg_card}};
    --button_border_hover: {{bg_hover}};
    --button_border_focus: {{accent}};
    --border_color: {{bg}};
    --tab_border: {{bg}};
    --tab_border_focus: {{accent}};
    --tab_border_selected: {{accent}};

    --scrollbar_handle: {{bg_hover}};
    --scrollbar_bg: {{bg}};
    --scrollbar_hover: {{border}};
    --scrollbar_down: {{accent}};
    --scrollbar_border: {{bg}};

    --list_item_bg_selected: {{selection_bg}};
    --list_item_bg_hover: {{bg_hover}};

    --palette_highlight: {{selection_bg}};
    --palette_highlightedText: {{selection_fg}};
    --palette_link: {{url}};
    --palette_linkVisited: {{url}};
}

/* Same font as kitty */
QWidget {
    font-family: 'JetBrainsMono Nerd Font', monospace;
    selection-color: {{selection_fg}};
}

/* Docks and their titles sit on the terminal background, no frames */
QDockWidget,
QDockWidget::title,
OBSDock > QWidget,
QStatusBar,
QMenuBar,
#transitionsFrame {
    background-color: {{bg}};
    border: none;
}

QDockWidget::title {
    color: {{accent}};
}

/* The preview's margins around the canvas: the terminal background, flat */
OBSQTDisplay {
    qproperty-displayBackgroundColor: {{bg}};
}

/* Remaining outlines Yami draws with fixed grey shades */
* [frameShape="6"],
QFrame[frameShape="4"],
QFrame[frameShape="5"],
QMenu > QMenu,
QScrollBar,
QHeaderView::section,
QDateTimeEdit::drop-down,
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button,
#previewXContainer,
#previewXScrollBar,
#previewYScrollBar,
#previewScalingMode,
#previewScalingMode:hover,
#previewScalingMode:focus,
#previewZoomInButton:focus,
#previewZoomOutButton:focus,
#hVolumeWidgets VolumeControl,
#vVolumeWidgets VolumeControl,
#vVolumeWidgets .mixer-category,
QStatusBar::item,
StatusBarWidget > QFrame {
    border: none;
}
